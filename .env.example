# GEMINI_API_KEY: Required for Gemini AI Pet Matchmaker.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# MySQL Database Configuration
# Cấu hình kết nối MySQL trực tiếp (Host, Port, User, Password, Database)
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="pawfund_db"

# Hoặc dùng chuỗi kết nối duy nhất (Connection String / URI):
# MYSQL_URL="mysql://root:password@localhost:3306/pawfund_db"
# DATABASE_URL="mysql://root:password@localhost:3306/pawfund_db"

# Real Email Service Configuration (Tùy chọn: Resend hoặc SendGrid)
# Hỗ trợ gửi thông báo đơn nhận nuôi và quyên góp thực tế
RESEND_API_KEY=""
#SENDGRID_API_KEY=""
EMAIL_FROM=""
